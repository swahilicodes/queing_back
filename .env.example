# =========================================
# QMS Backend - Environment Variables
# Copy this file to .env and fill in values
# =========================================

# Server
PORT=5005
NODE_ENV=development
APP_BASE_URL=http://localhost:5005

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# =========================================
# Database (MySQL)
# =========================================
DB_HOST=localhost
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=3306

# =========================================
# Jeeva API Configuration (Hospital System)
# =========================================
JEEVA_API_IP=192.168.235.65

# =========================================
# Kilakona SMS Gateway Configuration
# =========================================
KILAKONA_API_KEY=your_kilakona_api_key_here
KILAKONA_API_SECRET=your_kilakona_api_secret_here
KILAKONA_SENDER_ID=MLOGANZILA
KILAKONA_URL=https://messaging.kilakona.co.tz/api/v1/vendor/message/send
KILAKONA_CALLBACK_URL=https://your-server.com/delivery-callback

# =========================================
# Cron Schedules & Automation
# =========================================
ENABLE_CRON_JOBS=true
CRON_TIMEZONE=Africa/Dar_es_Salaam
CRON_SCHEDULE_DAILY_RESET=0 0 * * *
CRON_SCHEDULE_CLINICS_SYNC=0 0 * * *
CRON_SCHEDULE_INSURANCE_CHECK=*/2 * * * * *
CRON_SCHEDULE_UNPAID_CHECK=*/5 * * * * *
