# =========================================
# QMS Backend - Environment Configuration
# =========================================

# Server
PORT=5005
NODE_ENV=development
APP_BASE_URL=http://localhost:5005

# Authentication
JWT_SECRET=swahili codes

# =========================================
# Database (MySQL)
# =========================================
DB_HOST=localhost
DB_USER=marema
DB_PASSWORD=darkside
DB_NAME=queing_db
DB_PORT=3306

# =========================================
# Jeeva API Configuration (Hospital System)
# =========================================
# IP address for the Jeeva Hospital API service (e.g. 192.168.235.65 or 192.168.235.67)
JEEVA_API_IP=192.168.235.65

# =========================================
# Kilakona SMS Gateway Configuration
# =========================================
KILAKONA_API_KEY=chimwege
KILAKONA_API_SECRET=f5IZEc5o8PeXi9l5ilOo
KILAKONA_SENDER_ID=MLOGANZILA
KILAKONA_URL=https://messaging.kilakona.co.tz/api/v1/vendor/message/send
KILAKONA_CALLBACK_URL=https://your-server.com/delivery-callback

# Backwards compatibility aliases
kilakona_api_key=chimwege
kilakona_api_secret=f5IZEc5o8PeXi9l5ilOo

# =========================================
# Cron Schedules & Automation
# =========================================
# Master switch to enable/disable background crons (true/false)
ENABLE_CRON_JOBS=true

# Timezone for scheduled tasks
CRON_TIMEZONE=Africa/Dar_es_Salaam

# Daily token reset (default: midnight 00:00 every day)
CRON_SCHEDULE_DAILY_RESET=0 0 * * *

# Clinics sync from Jeeva API (default: midnight 00:00 every day)
CRON_SCHEDULE_CLINICS_SYNC=0 0 * * *

# Insurance tickets status check (default: every 2 seconds)
CRON_SCHEDULE_INSURANCE_CHECK=*/2 * * * * *

# Unpaid tickets check from Jeeva API (default: every 5 seconds)
CRON_SCHEDULE_UNPAID_CHECK=*/5 * * * * *